#default {
    height: 3;
    dock: top;
    background: $surface;
    color: $text;
}

#body {

}

#main_view {
    layout: horizontal;
    min-height: 20;
    padding: 1;
}

.rule {
    padding: 0;
}

#info_panels {
    width: 35;
    padding: 1;
}

#sim_time {
    padding: 1;
}

#operation {
    padding: 0;
}

#market {
    align: center middle;
    min-width: 60;
    width: 25%;
    padding: 1;
}

#agents-list {
    layout: grid;
    grid-size: 10;  
    align: center middle;
}

.agent-card {
    min-width: 15;
    max-width: 30;
    min-height: 4;
    padding: 1 1 0 0;
    background: $surface-darken-1;
}

.transaction-log-panel {
    min-width: 24;
    width: 60;
    height: 15;
}

.lob-panel-tab {

}

.lob-table {
    width: 33;
    min-height: 15;
    align: center middle;
}
